# Environment variables and local secrets
.env
.env.*
!.env.example

# Python virtual environments
.venv/
venv/
env/
ENV/

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checking, and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Coverage output
.coverage
.coverage.*
htmlcov/
coverage.xml

# Build and distribution artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
wheels/

# Runtime-generated files
*.log
*.pid
*.sqlite
*.sqlite3

# IDE and editor-generated files
.idea/
.vscode/*
!.vscode/settings.json
*.code-workspace
*.swp
*.swo
*~

# Operating-system generated files
.DS_Store
Thumbs.db
Desktop.ini

