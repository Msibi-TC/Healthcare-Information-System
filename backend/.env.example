# Application
API_V1_STR=/api/v1
PROJECT_NAME=Hospital Management System
VERSION=1.0.0

# Security
# Generate a unique, high-entropy value for each environment. Do not reuse this
# example value in a deployed system.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_DB=hospital_db
POSTGRES_PORT=5432

# CORS origins must be a JSON array.
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Optional initial superuser bootstrap values. Bootstrap logic is not implemented.
FIRST_SUPERUSER_EMAIL=
FIRST_SUPERUSER_PASSWORD=

# Email (optional; email functionality is not implemented)
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=Hospital Management System
